<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 (and smaller): Mahliyo in one of ten scenes (DkWidgets.mahliyoScene): her emotion large on the right,
     on the left a small line (🔥 and the streak), a short title, one line under it and a button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_s_morning" android:clipChildren="true">
    <ImageView android:id="@+id/w_face" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:layout_gravity="end|bottom" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" android:adjustViewBounds="true"
        android:scaleType="fitEnd" android:src="@drawable/widget_e01" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginEnd="132dp"
        android:gravity="center_vertical" android:orientation="vertical"
        android:paddingStart="18dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/w_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥 0" android:textColor="#B32A1D4A" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.04" android:maxLines="1" />
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="Субҳ ба хайр!" android:textColor="#FF2A1D4A" android:textSize="19sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.01"
            android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.95" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:text="Дарс барвақттар?" android:textColor="#CC2A1D4A" android:textSize="12.5sp" android:fontFamily="sans-serif"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/w_go" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp"
            android:background="@drawable/widget_go_light" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:text="Оғоз" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
