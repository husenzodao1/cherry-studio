<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 / 2×2: days in a row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/widget_flame" android:contentDescription="@null" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FF3F1F1A" android:textSize="30sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/w_streak_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="рӯз пай дар пай" android:textColor="#FF8A5A4E" android:textSize="12sp" android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
