<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2: today's learning -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_flame" android:contentDescription="@null" />
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="0" android:textColor="#FF3F1F1A" android:textSize="15sp" android:textStyle="bold" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/w_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Гулдухтар" android:textColor="#FFC44F4F" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/w_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="0" android:textColor="#FF3F1F1A" android:textSize="34sp" android:textStyle="bold" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_done_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="дарс хонда шуд" android:textColor="#FF8A5A4E" android:textSize="12sp" />
    <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress" />
    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_pill" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:text="Идома" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
