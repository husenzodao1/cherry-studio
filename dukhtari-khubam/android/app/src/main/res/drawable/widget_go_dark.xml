<?xml version="1.0" encoding="utf-8"?>
<!-- the Mahliyo widget's button on a deep scene: a white pill with a soft shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#40000000" /><corners android:radius="999dp" /></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FFF1ECFF" android:endColor="#FFFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
