<?xml version="1.0" encoding="utf-8"?>
<!-- the Mahliyo widget's button on a light scene: a cyan-to-indigo (boys) gradient pill with a light rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#33000000" /><corners android:radius="999dp" /></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF0EA5E9" android:centerColor="#FF2563EB" android:endColor="#FF4338CA" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
