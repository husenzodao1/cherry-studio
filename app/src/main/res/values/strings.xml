    <string name="btn_beep_stop">Қатъи садои санҷишӣ</string>

    <string name="section_receiver">Телефони Б — гиранда</string>
    <string name="hint_receiver">Ба Wi-Fi-и телефони А пайваст шавед ва «Гирифтан»-ро пахш кунед. IP-ро танҳо агар худкор наёбад нависед — IP-и телефони А, на ҳамин телефон.</string>
    <string name="hint_ip">IP-и телефони А (ихтиёрӣ)</string>
